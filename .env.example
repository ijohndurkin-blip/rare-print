# ─── AI (required for AI features) ─────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Optional model overrides
# OPENAI_TEXT_MODEL=gpt-5.4-mini           # layouts, copywriting, design review (needs vision + structured outputs)
# OPENAI_IMAGE_MODEL=gpt-image-2           # artwork
# OPENAI_IMAGE_MODEL_TRANSPARENT=gpt-image-1.5   # cut-out artwork with transparent background
# OPENAI_IMAGE_QUALITY=medium              # low | medium | high
# OPENAI_REASONING_EFFORT=low
# AI_REQUESTS_PER_HOUR=60                  # per visitor (image = 3 requests)

# ─── Orders dashboard ─────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me
# Secret used to sign download links and admin sessions (any long random string)
APP_SECRET=please-generate-a-long-random-string
# Public URL of this site, used in email links (defaults to the request origin)
# PUBLIC_BASE_URL=https://design.gocre8.co.uk
ORDER_PREFIX=GC

# ─── Storage ──────────────────────────────────────────────────────────────
# On Vercel: create a Blob store and connect it to the project; BLOB_READ_WRITE_TOKEN is then set for you.
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=public        # or "private" if your Blob store is private
# On a VPS / Docker (no Blob token): files are saved here
# DATA_DIR=./data
# MAX_UPLOAD_MB=80

# ─── Notifications (optional) ─────────────────────────────────────────────
# Email via Resend (https://resend.com): new-order email to the printer + confirmation to the customer
# RESEND_API_KEY=re_...
# EMAIL_FROM="go cre8 <orders@gocre8.co.uk>"
# ORDER_NOTIFY_EMAIL=info@gocre8.co.uk
# POST every new order as JSON to Zapier / Make / your own system
# ORDER_WEBHOOK_URL=https://hooks.zapier.com/...

# ─── White-label branding (all optional) ──────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=go cre8
NEXT_PUBLIC_BRAND_TAGLINE=Creative printers & sign makers
# NEXT_PUBLIC_BRAND_LOGO_URL=https://.../logo.svg
NEXT_PUBLIC_BRAND_WEBSITE=https://www.gocre8.co.uk
NEXT_PUBLIC_BRAND_PHONE=0151 345 1814
NEXT_PUBLIC_BRAND_EMAIL=info@gocre8.co.uk
NEXT_PUBLIC_BRAND_ADDRESS=1 Mann Street, Cains Brewery Village, Liverpool, L8 5AF
NEXT_PUBLIC_BRAND_CITY=Liverpool
# NEXT_PUBLIC_BRAND_PRIMARY=#e11d74
# NEXT_PUBLIC_BRAND_PRIMARY_DARK=#b0145a
# NEXT_PUBLIC_BRAND_ACCENT=#0ea5e9
# NEXT_PUBLIC_BRAND_INK=#0f172a
# NEXT_PUBLIC_CURRENCY_SYMBOL=£
# NEXT_PUBLIC_SHOW_PRICES=true
